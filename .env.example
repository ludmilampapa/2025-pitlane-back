# Connect to Supabase via connection pooling
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# Supabase project URL used for JWT JWKS verification
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# Legacy HS256 JWT secret (optional fallback if not using Asymmetric JWKS)
JWT_SECRET="your-supabase-jwt-secret"

# Comma-separated allowed frontend origins in production
FRONTEND_URL="https://your-frontend.vercel.app"

# Optional: team suffix to allow Vercel preview deployments, e.g. -your-team.vercel.app
# VERCEL_PREVIEW_SUFFIX="-your-team.vercel.app"

# Optional: reverse proxy hop count for req.ip / rate limiting (defaults to 1 in production)
# TRUST_PROXY=1
